#!/bin/bash
# cage — run Claude Code in an isolated Apple container (VM-level isolation)
#
# USAGE
#   cage [claude-args]     Run Claude from the current directory
#
# EXAMPLES
#   cd ~/projects/my-app && cage
#   cage --resume
#
# FIRST TIME SETUP
#   1. brew install container
#   2. container system start
#   3. cage-update          # build the image
#   4. cage-login           # authenticate (opens browser, one-time OAuth)
#   5. cage                 # ready
#
# OTHER COMMANDS
#   cage-login              # re-authenticate when token expires
#   cage-update             # rebuild image after Claude Code updates
#
# HOW IT WORKS
#   - Each container is a lightweight Linux VM (Apple Virtualization Framework)
#   - pwd is mounted at /home/claude/workspace — nothing else on your Mac is visible
#   - Credentials persist in ~/.local/share/cage/creds on the host
#   - Your ~/.claude config (CLAUDE.md, settings, commands, skills) is synced in read-only
#   - GIT_AUTHOR/COMMITTER name+email are passed as env vars for correct commit identity
#   - Runs as non-root with --dangerously-skip-permissions

set -e

# Ensure container system is running
if ! container system status 2>/dev/null | grep -q 'status.*running'; then
  echo "Container system not running. Starting..." >&2
  container system start
fi

# If we're inside a git worktree, also mount the main .git dir at its original
# absolute path so git can follow the worktree's gitdir pointer and commit.
WORKTREE_MOUNT=""
if COMMON=$(git -C "$(pwd)" rev-parse --git-common-dir 2>/dev/null); then
  GITDIR=$(git -C "$(pwd)" rev-parse --git-dir 2>/dev/null)
  if [ "$COMMON" != "$GITDIR" ]; then
    WORKTREE_MOUNT="--volume $COMMON:$COMMON"
  fi
fi

# Derive a readable container name from the repo and git branch (or directory names)
REPO=$(basename "$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null)
if [ -z "$REPO" ]; then
  REPO=$(basename "$(pwd)")
fi
BRANCH=$(git -C "$(pwd)" branch --show-current 2>/dev/null || true)
if [ -z "$BRANCH" ]; then
  BRANCH=$(basename "$(pwd)")
fi
CAGE_NAME="cage-$(printf '%s' "$REPO" | tr -cd 'a-zA-Z0-9-' | head -c 30)-$(printf '%s' "$BRANCH" | tr '/' '-' | tr -cd 'a-zA-Z0-9-' | head -c 30)"

# Auto-append numeric suffix if the name is already in use
BASE_NAME="$CAGE_NAME"
SUFFIX=2
while container list 2>/dev/null | grep -qw "$CAGE_NAME"; do
  CAGE_NAME="${BASE_NAME}-${SUFFIX}"
  SUFFIX=$((SUFFIX + 1))
done

CREDS_DIR="$HOME/.local/share/cage/creds"
mkdir -p "$CREDS_DIR"

# Read extra mounts from config file
EXTRA_MOUNTS=()
MOUNTS_CONF="$HOME/.config/cage/mounts"
HOST_PROJECT_ENCODED="$(pwd | sed 's|/|-|g')"

if [ ! -f "$MOUNTS_CONF" ]; then
  mkdir -p "$(dirname "$MOUNTS_CONF")"
  cat > "$MOUNTS_CONF" <<'EOF'
# Host directories to mount into the cage container.
# To reset to defaults, delete this file — cage will recreate it.
# Format: MODE  PATH
#
# MODE: rw (read-write) or ro (read-only)
# PATH: host path relative to ~ (mapped to same path under /home/claude in container)
#
# Variable expansion:
#   {project}  — encoded project directory (e.g. -Users-scotts-src-cage)
#
# Directories are created automatically if they don't exist.
# Lines starting with # and blank lines are ignored.

# Project memories and session transcripts (scoped to current project only)
rw  ~/.claude/projects/{project}

# Plans
rw  ~/.claude/plans
EOF
fi

while IFS= read -r line || [ -n "$line" ]; do
  line="$(echo "$line" | sed 's/#.*//' | xargs)"
  [ -z "$line" ] && continue

  mode="$(echo "$line" | awk '{print $1}')"
  host_path="$(echo "$line" | awk '{print $2}')"

  # Expand ~ and {project}
  host_path="$(echo "$host_path" | sed "s|^~|$HOME|" | sed "s|{project}|$HOST_PROJECT_ENCODED|g")"

  # Derive container path: replace $HOME with /home/claude
  container_path="$(echo "$host_path" | sed "s|^$HOME|/home/claude|")"

  mkdir -p "$host_path"

  if [ "$mode" = "ro" ]; then
    EXTRA_MOUNTS+=(--volume "$host_path:$container_path:ro")
  else
    EXTRA_MOUNTS+=(--volume "$host_path:$container_path")
  fi
done < "$MOUNTS_CONF"

TTY_FLAG="-it"
if [ ! -t 0 ]; then
  TTY_FLAG="-i"
fi

# Green tab = caged; reset on exit
if [ -n "$KITTY_WINDOW_ID" ]; then
  kitty @ set-tab-color active_bg=#003300 active_fg=#00ff88 inactive_bg=#001a00 inactive_fg=#005500 2>/dev/null || true
  trap 'kitty @ set-tab-color active_bg=NONE active_fg=NONE inactive_bg=NONE inactive_fg=NONE 2>/dev/null || true' EXIT
fi

container run $TTY_FLAG --rm \
  --name "$CAGE_NAME" \
  --init \
  --memory 4G \
  --cpus 2 \
  --volume "$(pwd):/home/claude/workspace" \
  --volume "$CREDS_DIR:/home/claude/.claude" \
  --volume "$HOME/.claude:/tmp/.claude-host:ro" \
  $WORKTREE_MOUNT \
  "${EXTRA_MOUNTS[@]}" \
  --env TERM \
  --env HOST_CWD="$(pwd)" \
  --env GIT_AUTHOR_NAME="$(git config user.name)" \
  --env GIT_AUTHOR_EMAIL="$(git config user.email)" \
  --env GIT_COMMITTER_NAME="$(git config user.name)" \
  --env GIT_COMMITTER_EMAIL="$(git config user.email)" \
  claude-isolated \
  claude --dangerously-skip-permissions "$@"
